{
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "singbox.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-resolver",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-direct",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "dns-resolver",
        "detour": "Direct ☘️"
      },
      {
        "tag": "dns-proxy",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "dns-resolver"
      },
      {
        "tag": "dns-fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "2001:2::/48"
      }
    ],
    "rules": [
      {
        "action": "reject",
        "rule_set": "geosite:anti-ad"
      },
      {
        "server": "dns-direct",
        "rule_set": [
          "geosite:mydirect",
          "geosite:tld-cn",
          "geosite:geolocation-cn"
        ]
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geosite:geolocation-!cn@cn"
          },
          {
            "rule_set": "geosite:geolocation-!cn"
          }
        ],
        "server": "dns-direct"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-proxy",
    "strategy": "prefer_ipv4",
    "cache_capacity": 4096,
    "reverse_mapping": true
  },
  "http_clients": [
    {
      "tag": "proxy-client",
      "detour": "🇭🇰 Hong Kong"
    }
  ],
  "inbounds": [
    {
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "route_address": [
        "0.0.0.0/1",
        "128.0.0.0/1",
        "::/1",
        "8000::/1"
      ],
      "route_exclude_address": [
        "192.168.0.0/16",
        "fc00::/7"
      ],
      "auto_route": true,
      "strict_route": true,
      "auto_redirect": false,
      "type": "tun"
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "::",
      "listen_port": 10808,
      "set_system_proxy": false
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🚀 Global",
      "outbounds": [
        "🇭🇰 Hong Kong",
        "🇺🇸 The United States of America",
        "🇬🇧 United Kingdom",
        "🇸🇬 Singapore",
        "✋ Proxy"
      ]
    },
    {
      "type": "selector",
      "tag": "✋ Proxy",
      "outbounds": [
        "#all"
      ]
    },
    {
      "type": "urltest",
      "tag": "🇬🇧 United Kingdom",
      "outbounds": [
        "+🇬🇧|英国|GB|gb|uk|UK"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m"
    },
    {
      "type": "urltest",
      "tag": "🇸🇬 Singapore",
      "outbounds": [
        "+sg|SG|新加坡|🇸🇬"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m"
    },
    {
      "type": "urltest",
      "tag": "🇭🇰 Hong Kong",
      "outbounds": [
        "+hk|HK|🇭🇰|香港|Hong Kong"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m"
    },
    {
      "type": "urltest",
      "tag": "🇺🇸 The United States of America",
      "outbounds": [
        "+美国|us|🇺🇸"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m"
    },
    {
      "tag": "Direct ☘️",
      "type": "direct",
      "udp_fragment": true
    }
  ],
  "route": {
    "rules": [
      {
        "action": "bypass",
        "rule_set": [
          "port:mybypass"
        ]
      },
      {
        "action": "sniff",
        "timeout": "800ms"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "Direct ☘️"
      },
      {
        "rule_set": [
          "geosite:anti-ad"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite:myproxy"
        ],
        "outbound": "🚀 Global"
      },
      {
        "rule_set": [
          "geosite:mydirect"
        ],
        "outbound": "Direct ☘️"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geosite:geolocation-!cn@cn"
          },
          {
            "rule_set": "geosite:geolocation-!cn"
          }
        ],
        "outbound": "Direct ☘️"
      },
      {
        "rule_set": [
          "geosite:geolocation-!cn"
        ],
        "outbound": "🚀 Global"
      },
      {
        "rule_set": [
          "geosite:geolocation-cn",
          "geosite:tld-cn"
        ],
        "outbound": "Direct ☘️"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite:anti-ad",
        "format": "binary",
        "http_client": "proxy-client",
        "url": "https://raw.githubusercontent.com/privacy-protection-tools/anti-ad.github.io/master/docs/anti-ad-sing-box.srs"
      },
      {
        "type": "remote",
        "tag": "geosite:myproxy",
        "format": "source",
        "http_client": "proxy-client",
        "url": "https://raw.githubusercontent.com/kumalum/file/main/sb/myproxy.json"
      },
      {
        "type": "remote",
        "tag": "port:mybypass",
        "format": "source",
        "http_client": "proxy-client",
        "url": "https://raw.githubusercontent.com/kumalum/file/main/sb/myreject.json"
      },
      {
        "type": "remote",
        "tag": "geosite:mydirect",
        "format": "source",
        "http_client": "proxy-client",
        "url": "https://raw.githubusercontent.com/kumalum/file/main/sb/mydirect.json"
      },
      {
        "type": "remote",
        "tag": "geosite:geolocation-!cn",
        "format": "binary",
        "http_client": "proxy-client",
        "url": "https://raw.githubusercontent.com/xmdhs/sing-geosite/rule-set/geosite-geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite:geolocation-cn",
        "format": "binary",
        "http_client": "proxy-client",
        "url": "https://raw.githubusercontent.com/xmdhs/sing-geosite/rule-set/geosite-geolocation-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite:geolocation-!cn@cn",
        "format": "binary",
        "http_client": "proxy-client",
        "url": "https://raw.githubusercontent.com/xmdhs/sing-geosite/rule-set/geosite-geolocation-!cn@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite:tld-cn",
        "format": "binary",
        "http_client": "proxy-client",
        "url": "https://raw.githubusercontent.com/xmdhs/sing-geosite/rule-set/geosite-tld-cn.srs"
      }
    ],
    "final": "🚀 Global",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-proxy"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "zashboard",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-no-fonts.zip",
      "external_ui_download_detour": "proxy-client"
    },
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "rdrc_timeout": "3d"
    }
  }
}
